# Node.js dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/cache/

# Build output
dist/
build/
out/
.next/
.vite/
*.tsbuildinfo

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# AI models and model cache
*.onnx
*.h5
*.pt
*.pth
*.tflite
.deepface/
.insightface/
model_cache/

# Biometric and sensitive data
face_data/
face_images/
face_embeddings/
biometric_data/
datasets/
uploads/
captures/

# Database and backups
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
backups/
postgres_data/
pgdata/

# Testing
coverage/
.nyc_output/
.coverage
htmlcov/
test-results/
playwright-report/
playwright/.auth/

# Docker local configuration
docker-compose.override.yml

# IDE and editor
.idea/
.vscode/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp/
temp/
.cache/
*.tmp
*.bak

# Antigravity local configuration
.agents/mcp_config.json
.agents/**/.cache/
.agents/**/__pycache__/

# MCP local configuration
.mcp.json
mcp_config.json
